# Copy this file to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=5000

# MySQL connection: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://root:user_password@localhost:3306/portfolio_db"

# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h

# Frontend address(es) allowed to call the API, comma separated
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Set to 1 when deployed behind a proxy (Render, Railway, Nginx) so rate limiting sees real IPs
TRUST_PROXY=0

# Email (SMTP). For Gmail use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Portfolio <your_email@gmail.com>"
NOTIFY_EMAIL=user@gmail.com

# Used only by "npm run seed" to create the admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password_12+_chars
